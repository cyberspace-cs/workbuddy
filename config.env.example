# ===== LLM 配置（OpenAI 兼容接口）=====
# 任意 OpenAI 兼容端点均可：OpenAI / Azure / Ollama(http://localhost:11434/v1) / vLLM 等
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# ===== 运行模式 =====
# auto  : 有密钥走真实模型，无密钥自动进入 Mock（默认，推荐）
# true  : 强制 Mock（无需密钥即可演示全链路）
# false : 强制真实模型
MOCK_MODE=auto

# ===== 生成参数 =====
TEMPERATURE=0.7
MAX_TOKENS=2000

# ===== 服务与存储 =====
HOST=0.0.0.0
PORT=8000
DATA_DIR=data
